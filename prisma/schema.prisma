// CircuLink — Prisma Schema
// AI-Powered B2B Industrial Waste Exchange Platform

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── ENUMS ──────────────────────────────────────────────────────────────────

enum UserRole {
  ADMIN
  COMPANY
}

enum CompanyType {
  SELLER
  BUYER
  BOTH
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum ListingStatus {
  DRAFT
  PENDING_REVIEW
  ACTIVE
  SOLD
  EXPIRED
  REMOVED
}

enum BidStatus {
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN
  COUNTERED
}

enum TransactionStatus {
  IN_PROGRESS
  COMPLETED
  CANCELLED
  DISPUTED
}

enum HazardClass {
  NONE
  CLASS_1
  CLASS_2
  CLASS_3
  CLASS_4
  CLASS_5
  CLASS_6
  CLASS_7
  CLASS_8
  CLASS_9
}

enum WasteCategory {
  METAL_SCRAP
  PLASTIC
  CHEMICAL_BYPRODUCTS
  TEXTILE_WASTE
  E_WASTE
  ORGANIC_AGRI
  CONSTRUCTION_DEBRIS
  PAPER_CARDBOARD
  GLASS
  RUBBER
  WOOD
  OIL_LUBRICANTS
  OTHER
}

enum ChainStatus {
  SUGGESTED
  INTEREST_EXPRESSED
  IN_DISCUSSION
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum ReportStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  DISMISSED
}

// ─── MODELS ─────────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  passwordHash  String    @map("password_hash")
  role          UserRole  @default(COMPANY)
  companyId     String?   @map("company_id")
  avatarUrl     String?   @map("avatar_url")
  emailVerified DateTime? @map("email_verified")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  company              Company?       @relation(fields: [companyId], references: [id])
  sentMessages         Message[]      @relation("SentMessages")
  receivedMessages     Message[]      @relation("ReceivedMessages")
  notifications        Notification[]
  reviewsGiven         Review[]       @relation("ReviewerReviews")
  reviewsReceived      Review[]       @relation("RevieweeReviews")
  reportsSubmitted     Report[]       @relation("ReporterReports")

  @@map("users")
}

model Company {
  id                 String             @id @default(cuid())
  name               String
  type               CompanyType        @default(BOTH)
  industrySector     String             @map("industry_sector")
  registrationNumber String?            @map("registration_number")
  description        String?
  logoUrl            String?            @map("logo_url")
  address            String
  city               String?
  state              String?
  country            String?
  postalCode         String?            @map("postal_code")
  geoLat             Float?             @map("geo_lat")
  geoLng             Float?             @map("geo_lng")
  phone              String?
  website            String?
  verificationStatus VerificationStatus @default(PENDING) @map("verification_status")
  verificationDocs   String[]           @map("verification_docs")
  certifications     String[]
  rating             Float              @default(0)
  totalReviews       Int                @default(0) @map("total_reviews")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  users                User[]
  wasteListings        WasteListing[]
  bidsPlaced           Bid[]              @relation("BuyerBids")
  sellerTransactions   Transaction[]      @relation("SellerTransactions")
  buyerTransactions    Transaction[]      @relation("BuyerTransactions")
  chainParticipations  ChainParticipant[]
  chatLogs             SustainabilityChatLog[]
  analyticsSnapshots   AnalyticsSnapshot[]

  @@map("companies")
}

model WasteListing {
  id                    String        @id @default(cuid())
  companyId             String        @map("company_id")
  title                 String
  wasteType             String        @map("waste_type")
  category              WasteCategory
  subCategory           String?       @map("sub_category")
  description           String
  quantity              Float
  unit                  String        @default("kg")
  images                String[]
  location              String
  geoLat                Float?        @map("geo_lat")
  geoLng                Float?        @map("geo_lng")
  hazardClass           HazardClass   @default(NONE) @map("hazard_class")
  condition             String?
  availabilityDate      DateTime?     @map("availability_date")
  isRecurring           Boolean       @default(false) @map("is_recurring")
  priceExpectation      Float?        @map("price_expectation")
  minimumBid            Float?        @map("minimum_bid")
  openToOffers          Boolean       @default(true) @map("open_to_offers")
  aiTags                String[]      @map("ai_tags")
  aiSuggestedIndustries String[]      @map("ai_suggested_industries")
  aiEstimatedValue      Float?        @map("ai_estimated_value")
  aiEstimatedCo2Savings Float?        @map("ai_estimated_co2_savings")
  aiClassificationData  Json?         @map("ai_classification_data")
  status                ListingStatus @default(DRAFT)
  viewCount             Int           @default(0) @map("view_count")
  createdAt             DateTime      @default(now()) @map("created_at")
  updatedAt             DateTime      @updatedAt @map("updated_at")

  company      Company       @relation(fields: [companyId], references: [id])
  bids         Bid[]
  transactions Transaction[]

  @@index([category])
  @@index([status])
  @@index([companyId])
  @@index([geoLat, geoLng])
  @@map("waste_listings")
}

model Bid {
  id                String    @id @default(cuid())
  listingId         String    @map("listing_id")
  buyerCompanyId    String    @map("buyer_company_id")
  bidAmount         Float     @map("bid_amount")
  quantityRequested Float     @map("quantity_requested")
  message           String?
  status            BidStatus @default(PENDING)
  counterAmount     Float?    @map("counter_amount")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  listing      WasteListing  @relation(fields: [listingId], references: [id])
  buyerCompany Company       @relation("BuyerBids", fields: [buyerCompanyId], references: [id])
  transaction  Transaction?

  @@index([listingId])
  @@index([buyerCompanyId])
  @@index([status])
  @@map("bids")
}

model Transaction {
  id              String            @id @default(cuid())
  listingId       String            @map("listing_id")
  bidId           String?           @unique @map("bid_id")
  sellerCompanyId String            @map("seller_company_id")
  buyerCompanyId  String            @map("buyer_company_id")
  finalAmount     Float             @map("final_amount")
  quantity        Float
  status          TransactionStatus @default(IN_PROGRESS)
  invoiceUrl      String?           @map("invoice_url")
  notes           String?
  completedAt     DateTime?         @map("completed_at")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  listing       WasteListing @relation(fields: [listingId], references: [id])
  bid           Bid?         @relation(fields: [bidId], references: [id])
  sellerCompany Company      @relation("SellerTransactions", fields: [sellerCompanyId], references: [id])
  buyerCompany  Company      @relation("BuyerTransactions", fields: [buyerCompanyId], references: [id])
  reviews       Review[]

  @@index([sellerCompanyId])
  @@index([buyerCompanyId])
  @@map("transactions")
}

model CollaborationChain {
  id                   String      @id @default(cuid())
  chainName            String      @map("chain_name")
  description          String?
  status               ChainStatus @default(SUGGESTED)
  aiConfidenceScore    Float?      @map("ai_confidence_score")
  estimatedTotalSavings Float?     @map("estimated_total_savings")
  estimatedCo2Reduction Float?     @map("estimated_co2_reduction")
  isFeatured           Boolean     @default(false) @map("is_featured")
  createdAt            DateTime    @default(now()) @map("created_at")
  updatedAt            DateTime    @updatedAt @map("updated_at")

  participants ChainParticipant[]

  @@map("collaboration_chains")
}

model ChainParticipant {
  id              String @id @default(cuid())
  chainId         String @map("chain_id")
  companyId       String @map("company_id")
  roleInChain     String @map("role_in_chain")
  inputMaterial   String? @map("input_material")
  outputMaterial  String? @map("output_material")
  orderIndex      Int    @default(0) @map("order_index")
  hasExpressedInterest Boolean @default(false) @map("has_expressed_interest")

  chain   CollaborationChain @relation(fields: [chainId], references: [id], onDelete: Cascade)
  company Company            @relation(fields: [companyId], references: [id])

  @@unique([chainId, companyId])
  @@map("chain_participants")
}

model Conversation {
  id           String    @id @default(cuid())
  listingId    String?   @map("listing_id")
  bidId        String?   @map("bid_id")
  chainId      String?   @map("chain_id")
  participantIds String[] @map("participant_ids")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  messages Message[]

  @@map("conversations")
}

model Message {
  id             String   @id @default(cuid())
  conversationId String   @map("conversation_id")
  senderId       String   @map("sender_id")
  receiverId     String?  @map("receiver_id")
  content        String
  isRead         Boolean  @default(false) @map("is_read")
  createdAt      DateTime @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation("SentMessages", fields: [senderId], references: [id])
  receiver     User?        @relation("ReceivedMessages", fields: [receiverId], references: [id])

  @@index([conversationId])
  @@index([senderId])
  @@map("messages")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  type      String
  title     String
  content   String
  link      String?
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId, isRead])
  @@map("notifications")
}

model SustainabilityChatLog {
  id        String   @id @default(cuid())
  companyId String   @map("company_id")
  messages  Json     @default("[]")
  title     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id])

  @@index([companyId])
  @@map("sustainability_chat_logs")
}

model AnalyticsSnapshot {
  id                     String   @id @default(cuid())
  companyId              String?  @map("company_id")
  period                 String
  totalWasteDiverted     Float    @default(0) @map("total_waste_diverted")
  revenueGenerated       Float    @default(0) @map("revenue_generated")
  co2Saved               Float    @default(0) @map("co2_saved")
  activeListings         Int      @default(0) @map("active_listings")
  completedTransactions  Int      @default(0) @map("completed_transactions")
  createdAt              DateTime @default(now()) @map("created_at")

  company Company? @relation(fields: [companyId], references: [id])

  @@index([companyId, period])
  @@map("analytics_snapshots")
}

model Review {
  id            String   @id @default(cuid())
  transactionId String   @map("transaction_id")
  reviewerId    String   @map("reviewer_id")
  revieweeId    String   @map("reviewee_id")
  rating        Int
  comment       String?
  createdAt     DateTime @default(now()) @map("created_at")

  transaction Transaction @relation(fields: [transactionId], references: [id])
  reviewer    User        @relation("ReviewerReviews", fields: [reviewerId], references: [id])
  reviewee    User        @relation("RevieweeReviews", fields: [revieweeId], references: [id])

  @@unique([transactionId, reviewerId])
  @@map("reviews")
}

model Report {
  id         String       @id @default(cuid())
  reportedBy String       @map("reported_by")
  targetType String       @map("target_type")
  targetId   String       @map("target_id")
  reason     String
  details    String?
  status     ReportStatus @default(OPEN)
  resolvedAt DateTime?    @map("resolved_at")
  createdAt  DateTime     @default(now()) @map("created_at")

  reporter User @relation("ReporterReports", fields: [reportedBy], references: [id])

  @@index([status])
  @@map("reports")
}
